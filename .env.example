# Cle API Anthropic — https://console.anthropic.com  (OBLIGATOIRE)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Modele utilise (optionnel, defaut : claude-sonnet-4-6)
# Pour reduire les couts : claude-haiku-4-5-20251001 (moins precis)
CLAUDE_MODEL=claude-sonnet-4-6

# Contexte commercial : ce que vend l'utilisateur (optionnel).
# Sert a cibler le bon decideur. Laisser vide = defaut generique industrie.
SELLER_CONTEXT=
