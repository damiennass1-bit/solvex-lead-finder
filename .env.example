# Cle API Anthropic — https://console.anthropic.com  (OBLIGATOIRE)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Modele utilise (optionnel, defaut : claude-haiku-4-5-20251001)
# Pour plus de qualite : claude-sonnet-4-6 (un peu plus cher)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Contexte commercial : ce que vend l'utilisateur (optionnel).
# Sert a cibler le bon decideur. Laisser vide = defaut generique industrie.
SELLER_CONTEXT=

# Cle Apollo (OPTIONNELLE) : si renseignee, l'app tente de recuperer des
# emails VERIFIES via Apollo au lieu de les deduire. Consomme des credits Apollo.
# A tester avec ta propre cle. Sans cette cle, l'app fonctionne en mode deduction honnete.
APOLLO_API_KEY=
